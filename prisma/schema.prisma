generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  bookings Booking[]
}

// Hubs (Oslo, Copenhagen) are where Waypoint flies from; the rest are destinations.
model Airport {
  code        String  @id
  slug        String  @unique
  city        String
  country     String
  tagline     String
  description String
  hub         Boolean @default(false)

  departures Flight[] @relation("departures")
  arrivals   Flight[] @relation("arrivals")
}

model Flight {
  id              String @id
  flightNumber    String @unique
  originCode      String
  destinationCode String
  departureTime   String
  arrivalTime     String
  duration        String
  cabin           String @default("Flex")
  baseFare        Int
  bagPrice        Int
  currency        String @default("EUR")

  origin      Airport   @relation("departures", fields: [originCode], references: [code])
  destination Airport   @relation("arrivals", fields: [destinationCode], references: [code])
  seats       Seat[]
  extras      Extra[]
  bookings    Booking[]

  @@index([originCode, destinationCode])
}

model Seat {
  id       String @id
  flightId String
  label    String
  price    Int
  status   String
  type     String

  flight   Flight    @relation(fields: [flightId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([flightId])
}

model Extra {
  id          String @id
  flightId    String
  label       String
  description String
  price       Int

  flight   Flight    @relation(fields: [flightId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([flightId])
}

model Booking {
  id        String   @id @default(cuid())
  reference String   @unique
  userId    String
  flightId  String
  date      String
  bags      Int
  carryOn   Boolean
  seatId    String?
  total     Int
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  flight Flight  @relation(fields: [flightId], references: [id], onDelete: Cascade)
  seat   Seat?   @relation(fields: [seatId], references: [id])
  extras Extra[]

  @@index([userId])
  @@index([flightId, date])
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Booking {
  id              String @id
  userId          String
  destinationSlug String
  reference       String @unique
  cabin           String
  baseFare        Int
  bagPrice        Int
  currency        String @default("EUR")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationSlug], references: [slug])
  flight      Flight?
  seats       Seat[]
  extras      Extra[]

  @@index([userId])
}

model User {
  id       String @id
  name     String
  initials String
  accent   String

  bookings Booking[]
}

model Destination {
  slug        String @id
  city        String
  country     String
  airport     String
  tagline     String
  description String
  accent      String

  bookings Booking[]
}

model Flight {
  id               String @id
  bookingId        String @unique
  flightNumber     String
  departureAirport String
  departureCity    String
  departureTime    String
  arrivalAirport   String
  arrivalCity      String
  arrivalTime      String
  date             String
  duration         String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Seat {
  id        String @id
  bookingId String
  label     String
  price     Int
  status    String
  type      String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Extra {
  id          String @id
  bookingId   String
  label       String
  description String
  price       Int

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

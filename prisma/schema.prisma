generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  createdAt DateTime @default(now())

  bookings  Booking[]
  seatHolds SeatHold[]
}

model Airport {
  code        String  @id
  slug        String  @unique
  city        String
  country     String
  tagline     String
  description String
  hub         Boolean @default(false)

  departures Flight[] @relation("departures")
  arrivals   Flight[] @relation("arrivals")
}

model Flight {
  id              String @id
  flightNumber    String @unique
  originCode      String
  destinationCode String
  departureTime   String
  arrivalTime     String
  duration        String
  basicFare       Int
  flexFare        Int
  bagPrice        Int
  currency        String @default("EUR")
  operatingDays   Int[]  @default([0, 1, 2, 3, 4, 5, 6])

  origin      Airport   @relation("departures", fields: [originCode], references: [code])
  destination Airport   @relation("arrivals", fields: [destinationCode], references: [code])
  seats       Seat[]
  extras      Extra[]
  bookings    Booking[]
  seatHolds   SeatHold[]

  @@index([originCode, destinationCode])
}

model Seat {
  id       String @id
  flightId String
  label    String
  price    Int
  type     String

  flight    Flight     @relation(fields: [flightId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  seatHolds SeatHold[]

  @@index([flightId])
}

model Extra {
  id          String @id
  flightId    String
  label       String
  description String
  price       Int

  flight   Flight    @relation(fields: [flightId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([flightId])
}

model SeatHold {
  id        String   @id @default(cuid())
  flightId  String
  date      String
  seatId    String
  userId    String
  expiresAt DateTime

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)
  seat   Seat   @relation(fields: [seatId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([flightId, date, seatId])
  @@index([userId])
}

model Booking {
  id        String   @id @default(cuid())
  reference String   @unique
  userId    String?
  flightId  String
  date      String
  passenger String
  cabin     String
  bags      Int
  carryOn   Boolean
  seatId    String?
  total     Int
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  flight Flight  @relation(fields: [flightId], references: [id], onDelete: Cascade)
  seat   Seat?   @relation(fields: [seatId], references: [id])
  extras Extra[]

  @@index([userId])
  @@index([flightId, date])
}
